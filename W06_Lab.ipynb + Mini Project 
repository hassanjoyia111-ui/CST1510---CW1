        "# ==================================================================== LOAD\n",
        "\n",
        "data = {\n",
        "    \"label\": [\"AI-001\", \"AI-002\", \"AI-003\", \"AI-004\", \"AI-005\", \"AI-006\"],\n",
        "    \"value\": [87, 120, 45, 93, 101, 60],\n",
        "    \"limit\": [100, 100, 100, 100, 100, 100]\n",
        "}\n",
        "\n",
        "\n",
        "# ================================================================= PROCESS\n",
        "\n",
        "df[\"percent\"] = (df[\"value\"] / df[\"limit\"]) * 100\n",
        "\n",
        "df[\"status\"] = df[\"percent\"].apply(\n",
        "    lambda p: \"OVER LIMIT\" if p >= 100\n",
        "    else \"WARNING\" if p >= 90\n",
        "    else \"OK\"\n",
        ")\n",
        "\n",
        "# ================================================================== OUTPUT\n",
        "\n",
        "print(df)\n",
        "print(df[[\"label\", \"value\", \"limit\", \"percent\"]]) # Prints the DataFrame with percentage\n",
        "print(df[df[\"status\"] != \"OK\"])   # Filters and displays records that are not OK\n",
        "print(df.groupby(\"status\")[\"label\"].count()) # groups by status and count records\n",
        "df.to_csv(\"records_report.csv\", index=False) # Saves the complete DataFrame as a CSV file\n",
        "\n",
        "import matplotlib.pyplot as plt # Imports Matplotlib for the bar chart\n",
        "df[\"status\"].value_counts().plot(kind=\"bar\") # Creates a bar chart showing counts per status\n",
        "plt.title(\"Record Status Counts\")\n",
        "plt.savefig(\"status_counts.png\") # Displays the bar chart\n",
        "plt.show()\n",
        "\n"
